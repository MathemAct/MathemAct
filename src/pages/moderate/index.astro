    overflow-wrap: break-word;
  }

  .transcript {
    margin-block-start: var(--space-2xs);
  }

  .transcript summary {
    font-size: var(--size-2);
    cursor: pointer;
  }

  .transcript pre {
    margin-block-start: var(--space-sm);
    padding: var(--space-sm);
    max-height: 24rem;
    overflow: auto;
    border: var(--border);
