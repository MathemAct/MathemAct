---
/**
 * Suggesting a claim.
 *
 * Most of this page is the guidance, and that is the right proportion. A badly formed
 * claim is worse than none: it collects ratings that cannot be interpreted, and once
 * people have answered it the wording is fixed, so there is no fixing it afterwards. Ten
 * seconds of reading here saves a claim that nobody can read an answer off.
 *
 * The three rules are the ones that actually go wrong — one claim, decidable, no
 * conjunctions — and each is shown with a bad example beside a good one, because "avoid
 * conjunctions" means nothing until you see the sentence it is warning you about.
 */
import Account from '../../layouts/Account.astro';
import Field from '../../components/Field.astro';
import FormStatus from '../../components/FormStatus.astro';
import RatingScale from '../../components/RatingScale.astro';
import TagPicker from '../../components/TagPicker.astro';
import { path } from '../../lib/paths';
import { AREAS } from '../../lib/report-schema';
import { listReports } from '../../lib/reports';

/**
 * The corpus, for the source picker, at build time.
 *
 * Title and id only, newest first. Read from `data/` like every other read on this site, so the
 * control is populated without the page opening a connection — and if the corpus is empty the
 * select says so rather than offering an empty menu.
 */
const reports = (await listReports()).map((report) => ({
  id: report.id,
  title: report.title,
}));
---

<Account
  title="Suggest a claim"
  description="Propose a single claim about AI use in mathematics for the community to answer."
  lead="One claim, in a sentence, and where you stand on it."
  gate="required"
>
  <div class="panel" data-gate-unconfirmed hidden>
    <p class="panel__heading">Confirm your email address first</p>
    <p>
      Proposing needs a confirmed address, for the same reason posting a report does.
      <a href={path('/account/confirm/')}>Get another confirmation link</a>.
    </p>
  </div>

  <div data-propose-wrap hidden>

    <form class="form" id="propose" novalidate>
      <FormStatus id="propose-status" />

      {/* Only ever visible when somebody arrived here by selecting a passage and choosing
          "cite this in a claim". The claim is theirs to write; this is the evidence
          they had in hand when they decided it was worth asking. */}
      <div class="quote-strip" data-quote-strip hidden>
        <p class="quote-strip__label meta">Responding to</p>
        <blockquote class="quote-strip__text" data-quote-text></blockquote>
        <p class="quote-strip__source">
          from <a data-quote-source href="#"></a>
        </p>

        <div class="field">
          <label class="field__label" for="bearing">
            How this bears on the claim
            <span class="field__optional">optional</span>
          </label>
          <div class="field__hint" id="bearing-hint">
            <p>
              One line, shown in that page's <strong>referenced by</strong> list — "the
              case that prompted this", "an account that cuts the other way".
            </p>
          </div>
          <input
            class="field__control"
            type="text"
            id="bearing"
            maxlength={500}
            aria-describedby="bearing-hint"
          />
        </div>

        <button class="link-button" type="button" data-quote-discard>
          Propose without the reference
        </button>
      </div>

      <Field
        id="statement"
        label="The claim"
        type="textarea"
        required
        rows={3}
        maxlength={200}
        counter
        hint="One sentence. Between 10 and 200 characters."
        example="Every AI-generated proof step must be checked by a human before publication."
      />

      <div class="field">
        <span class="field__label" id="area-label">Area</span>
        <fieldset class="choices" aria-labelledby="area-label">
          <legend class="visually-hidden">Which kind of work this claim is about</legend>
          {
            AREAS.map((choice) => (
              <label class="choice" for={`parea-${choice.value}`}>
                <input
                  class="choice__input"
                  type="radio"
                  id={`parea-${choice.value}`}
                  name="area"
                  value={choice.value}
                />
                <span>{choice.label}</span>
              </label>
            ))
          }
        </fieldset>
        <p class="field__error" id="area-error" hidden></p>
      </div>

      <Field
        id="rationale"
        label="The reasoning behind it"
        type="textarea"
        rows={4}
        maxlength={500}
        counter
        hint="Optional, 500 characters."
      />

      {/* ── Your own position ─────────────────────────────────────────────────────────
          Required, and the reason is not symmetry with the claim page. **Somebody unwilling
          to say where they stand should not be setting the question**: a claim is only worth
          answering if its author was willing to be counted on it, and a proposer who abstains
          is setting a question for other people to be measured against.

          It becomes the first entry in the distribution, which is also the honest ordering.

          `RatingScale` is the same control the claim page uses, so the answer is given in the
          same shape it will be read in — including "no opinion, or outside my expertise", which
          is a real answer here too. Nothing is selected on load: a preselected default would be
          an opinion the form supplied. */}
      <div class="field">
        <RatingScale name="score" />
        <p class="field__error" id="score-error" hidden></p>
      </div>

      {/* ── Tags ──────────────────────────────────────────────────────────────────────
          The same vocabulary reports use — the 32 arXiv mathematics categories — because the
          question a tag answers is the same on both surfaces. Optional. */}
      <div class="field">
        <span class="field__label" id="tags-label">
          Subject areas
          <span class="field__optional">optional</span>
        </span>
        <div aria-labelledby="tags-label">
          <TagPicker />
        </div>
      </div>

      {/* ── Where it came from ────────────────────────────────────────────────────────
          One or the other, never both, which the database also refuses. Radios rather than two
          always-open inputs, so the exclusivity is visible before it is enforced — and a
          bespoke fieldset rather than `Field.astro`, which renders its own control from a
          `type` prop and would silently ship a text input where these belong. */}
      <div class="field">
        <span class="field__label" id="source-label">
          What prompted it
          <span class="field__optional">optional</span>
        </span>
        <div class="field__hint" id="source-hint">
          <p>
            A link, or a report already in this corpus.
          </p>
        </div>

        <fieldset class="choices" aria-labelledby="source-label" aria-describedby="source-hint">
          <legend class="visually-hidden">Whether to give a source, and which kind</legend>
          <label class="choice" for="source-none">
            <input class="choice__input" type="radio" id="source-none" name="source" value="none" checked />
            <span>No source</span>
          </label>
          <label class="choice" for="source-link">
            <input class="choice__input" type="radio" id="source-link" name="source" value="url" />
            <span>A link</span>
          </label>
          <label class="choice" for="source-report">
            <input class="choice__input" type="radio" id="source-report" name="source" value="report" />
            <span>A report from this corpus</span>
          </label>
        </fieldset>

        <div class="field" data-source-url hidden>
          <label class="field__label" for="source-url">The link</label>
          <input
            class="field__control"
            type="url"
            id="source-url"
            maxlength={500}
            placeholder="https://"
            aria-describedby="source-url-hint source-url-error"
          />
          <p class="field__error" id="source-url-error" hidden></p>
        </div>

        <div class="field" data-source-report hidden>
          <label class="field__label" for="source-report-id">The report</label>
          <div class="field__hint" id="source-report-hint">
            <p>
              {reports.length === 0
                ? 'There are no reports in the corpus yet, so there is nothing to choose. Give a link instead.'
                : ''}
            </p>
          </div>
          {/* A native select, because the corpus is the vocabulary and it is short. It becomes
              a search problem at a few hundred reports and is not one yet; when it is, this is
              the control to replace. */}
          <select class="field__control" id="source-report-id" aria-describedby="source-report-hint">
            <option value="">Choose a report…</option>
            {reports.map((report) => (
              <option value={report.id}>{report.title}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="actions">
        <button class="button button--primary" type="submit">Suggest it</button>
        <a href={path('/opinions/')}>Back to all opinions</a>
      </div>

      <p class="field__hint">
        A moderator only steps in if somebody flags it, and then says in writing what they
        decided.
      </p>
    </form>
  </div>
</Account>

<script>
  import { createCitation } from '../../lib/citations';
  import { proposeClaim } from '../../lib/claims';
  import { path } from '../../lib/paths';
  import { loadProfile, mayPost } from '../../lib/profile';
  import { clearPassage, getPassage, type Passage } from '../../lib/quote';
  import { startSession, subscribeToSession } from '../../lib/session';
  import {
    clearFieldErrors,
    hideStatus,
    query,
    setBusy,
    setFieldError,
    showStatus,
    syncCounters,
    wireCounters,
  } from '../../lib/forms';
  import { validateRequiredText, validateOptionalText } from '../../lib/validation';
  import type { Area } from '../../lib/report-schema';

  const form = query<HTMLFormElement>('#propose');
  const wrap = query<HTMLElement>('[data-propose-wrap]');
  const status = query<HTMLElement>('#propose-status');
  const submit = query<HTMLButtonElement>('button[type="submit"]', form);
  const statement = query<HTMLTextAreaElement>('#statement', form);
  const rationale = query<HTMLTextAreaElement>('#rationale', form);
  const strip = query<HTMLElement>('[data-quote-strip]', form);
  const bearing = query<HTMLInputElement>('#bearing', form);
  const scoreError = query<HTMLElement>('#score-error', form);
  const sourceUrlWrap = query<HTMLElement>('[data-source-url]', form);
  const sourceReportWrap = query<HTMLElement>('[data-source-report]', form);
  const sourceUrl = query<HTMLInputElement>('#source-url', form);
  const sourceReport = query<HTMLSelectElement>('#source-report-id', form);

  let userId: string | null = null;

  // Both counters — the claim's and the reasoning's — are rendered by `Field.astro`, which
  // renders a counter but cannot animate it. Without this they sit at 0 while somebody types,
  // which this form has shipped once already.
  wireCounters(form);

  // ── Which source, if any ────────────────────────────────────────────────────────────
  // Exclusive by construction: only one of the two inputs is ever on the page, so there is no
  // state in which both hold a value and the submission has to choose. `claims_one_source`
  // refuses both anyway; this makes it impossible to reach.

  for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="source"]')) {
    radio.addEventListener('change', () => {
      const kind = form.querySelector<HTMLInputElement>('input[name="source"]:checked')?.value;

      sourceUrlWrap.hidden = kind !== 'url';
      sourceReportWrap.hidden = kind !== 'report';

      // Cleared on the way out, so a value typed and then switched away from is not submitted
      // by a field nobody can see.
      if (kind !== 'url') sourceUrl.value = '';
      if (kind !== 'report') sourceReport.value = '';

      if (kind === 'url') sourceUrl.focus();
      if (kind === 'report') sourceReport.focus();
    });
  }

  // ── The carried passage ─────────────────────────────────────────────────────────────
  // Read once, on load, rather than at submission time. Reading it later would attach a
  // quotation somebody had cleared in another tab in between.
  let attached: Passage | null = getPassage();

  if (attached) {
    strip.hidden = false;
    query<HTMLElement>('[data-quote-text]', strip).textContent = attached.text;

    const link = query<HTMLAnchorElement>('[data-quote-source]', strip);
    link.textContent = attached.sourceTitle;
    link.href = attached.commentId
      ? `${attached.sourceHref}#comment-${attached.commentId}`
      : attached.sourceHref;
  }

  query<HTMLButtonElement>('[data-quote-discard]', strip).addEventListener('click', () => {
    clearPassage();
    attached = null;
    strip.hidden = true;
    statement.focus();
  });

  subscribeToSession((state) => {
    if (state.status !== 'signed-in') return;
    if (userId === state.userId) return;

    userId = state.userId;
    void open(state.userId);
  });

  void startSession();

  async function open(id: string): Promise<void> {
    const profile = await loadProfile(id);

    if (profile.ok && !mayPost(profile.value)) {
      query<HTMLElement>('[data-gate-unconfirmed]').hidden = false;
      return;
    }

    wrap.hidden = false;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearFieldErrors(form);
    hideStatus(status);

    if (!userId) return;

    const area = form.querySelector<HTMLInputElement>('input[name="area"]:checked')?.value;
    const statementError =
      validateRequiredText(statement.value, 200, 'A claim') ??
      (statement.value.trim().length < 10
        ? 'That is shorter than a claim. Say what you are asserting in a full sentence.'
        : null);

    setFieldError('statement', statementError, form);
    setFieldError(
      'rationale',
      validateOptionalText(rationale.value, 500, 'The reasoning'),
      form,
    );

    const areaError = query<HTMLElement>('#area-error', form);
    areaError.textContent = area ? '' : 'Choose which kind of work this claim is about.';
    areaError.hidden = Boolean(area);

    /**
     * The proposer's own position, required.
     *
     * `'none'` is the off-scale answer and is a valid submission; `undefined` is an untouched
     * scale and is not. Nothing is selected on load, so those two states are genuinely
     * different, and collapsing them is the mistake the RPC's two parameters exist to prevent.
     */
    const chosen = form.querySelector<HTMLInputElement>('input[name="score"]:checked')?.value;
    const offScale = chosen === 'none';
    const score = chosen === undefined || offScale ? null : Number(chosen);

    scoreError.textContent =
      chosen === undefined
        ? 'Say where you stand on your own claim. "No opinion, or outside my expertise" counts.'
        : '';
    scoreError.hidden = chosen !== undefined;

    // Validated here so the message names the field; the trigger raises the same sentences and
    // is still the truth. A caller that skipped this form would meet it instead.
    const kind = form.querySelector<HTMLInputElement>('input[name="source"]:checked')?.value;
    const url = kind === 'url' ? sourceUrl.value.trim() : '';
    const reportId = kind === 'report' ? sourceReport.value : '';

    const urlError =
      kind !== 'url' || url === ''
        ? null
        : url.length > 500
          ? 'That link is longer than 500 characters. Check it is the link you meant.'
          : !/^https:\/\/\S+$/.test(url)
            ? 'Links have to start with https://. A link nobody can open from outside is not a source.'
            : null;

    setFieldError('source-url', urlError, form);

    if (statementError || !area || chosen === undefined || urlError) {
      showStatus(status, 'error', 'The claim still needs work. See the notes below.');
      return;
    }

    setBusy(submit, true, 'Suggesting…');
    const result = await proposeClaim({
      statement: statement.value,
      rationale: rationale.value,
      area: area as Area,
      score,
      offScale,
      tagCodes: [
        ...form.querySelectorAll<HTMLInputElement>('.tag__input:checked'),
      ].map((input) => input.value),
      sourceUrl: url || null,
      sourceReportId: reportId || null,
    });
    setBusy(submit, false);

    if (!result.ok) {
      showStatus(status, 'error', result.message);
      return;
    }

    // The reference is recorded second, against the claim that now exists. A failure
    // here leaves a proposed claim with no citation attached, which is a smaller loss than
    // withdrawing something already written — and the message says which half went through.
    let citationFailed: string | null = null;

    if (attached) {
      const linked = await createCitation(
        {
          sourceType: 'claim',
          sourceId: result.value,
          targetType: attached.sourceType,
          targetId: attached.sourceId,
          targetCommentId: attached.commentId,
          excerpt: attached.text,
          context: bearing.value,
        },
        userId,
      );

      if (!linked.ok) citationFailed = linked.message;

      clearPassage();
      attached = null;
      strip.hidden = true;
    }

    showStatus(
      status,
      citationFailed ? 'notice' : 'success',
      citationFailed
        ? [citationFailed, 'The claim itself is proposed and open for answers.']
        : [
            'Proposed. It is open for answers straight away.',
            'It is in the listing now, and has its own page within a few minutes.',
          ],
    );

    // A way to it. The view page renders it now and hands over to the built page once the
    // rebuild has made one, so this link is right whenever it is followed.
    const open = document.createElement('p');
    const link = document.createElement('a');
    link.href = `${path('/opinions/view/')}?id=${encodeURIComponent(result.value)}`;
    link.textContent = 'Go to your claim';
    open.append(link);
    status.append(open);

    form.reset();

    // `reset()` puts the radios back but not the panels they revealed, and it does not re-run a
    // change event. Without this the link field stays open after a successful submission,
    // holding nothing, above a form that has been cleared.
    sourceUrlWrap.hidden = true;
    sourceReportWrap.hidden = true;
    scoreError.hidden = true;

    // The counters are rendered from the DOM and do not follow a reset by themselves.
    syncCounters(form);
  });
</script>
