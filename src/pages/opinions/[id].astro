---
/**
 * One claim, and what the community made of it.
 *
 * The rule that shapes the whole page: **the distribution is not shown until the reader has
 * answered.** Not hidden behind a click — absent from the page, fetched afterwards. Baking
 * it into the HTML and hiding it with CSS would make bandwagon protection a decoration that
 * view-source defeats.
 *
 * Worth being straight about what this is and is not. The aggregate endpoint is public by
 * design and anyone determined can query it directly; what this prevents is the ordinary
 * reader forming a view after seeing where everyone else landed, which is where the effect
 * comes from. CLAUDE.md's reason for the rule is worth repeating because it is not the
 * usual one: this community's minority position is frequently the correct one.
 */
import Base from '../../layouts/Base.astro';
import AnswerContribution from '../../components/AnswerContribution.astro';
import Contributions from '../../components/Contributions.astro';
import FormStatus from '../../components/FormStatus.astro';
import Histogram from '../../components/Histogram.astro';
import RatingScale from '../../components/RatingScale.astro';
import References from '../../components/References.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { referencesFrom, referencesTo } from '../../lib/citations';
import { threadFor } from '../../lib/comments';
import { path } from '../../lib/paths';
import { areaLabel } from '../../lib/report-schema';
import { getClaim, listClaims, statsFor } from '../../lib/claims';

export async function getStaticPaths() {
  const claims = await listClaims();
  return claims.map((claim) => ({ params: { id: claim.id } }));
}

const { id } = Astro.params;
const claim = await getClaim(id!);

if (!claim) return Astro.redirect(path('/opinions/'));

const [thread, incoming, outgoing] = await Promise.all([
  threadFor('claim', claim.id),
  referencesTo('claim', claim.id),
  referencesFrom('claim', claim.id),
]);

/**
 * Flattened, because contributions on a claim are flat.
 *
 * `threadFor()` returns roots each carrying their replies, which is the shape a report thread
 * needs. Any reply still in the corpus on a claim is historical — the database refuses a new
 * one — and it is flattened into the list rather than dropped: a remark somebody wrote is not a
 * schema change's to withdraw. It loses its indent and keeps its place.
 */
const contributions = thread.flatMap((node) => [node.comment, ...node.replies]);
---

<Base title={claim.statement} description={claim.rationale ?? claim.statement}>
  <div class="shell corpus claim">
    <p class="breadcrumb"><a href={path('/opinions/')}>← All opinions</a></p>

    {/* The statement and the rationale are quotable; the rating control is not. */}
    <header class="claim__hero" data-quotable data-pagefind-body>
      <span data-pagefind-filter="type:claim" hidden></span>

      <div class="claim__eyebrow">
        <span class="claim__pill claim__pill--status">
          {claim.status === 'active' ? 'Active claim' : 'Proposed'}
        </span>

        <span class="claim__pill" data-pagefind-filter="area">
          {areaLabel(claim.area)}
        </span>
      </div>

      {/* The statement is the page. Set as a blockquote because it is a claim being
          reported rather than the site speaking — and as the h1 inside it, because it is
          also the page's subject. A blockquote takes flow content, so a heading is legal
          there; what is not legal is the other nesting, an h1 wrapping a blockquote.
          Without this the page had no h1 at all and its first heading was "1. Where do you
          stand?", which is what a screen reader's heading list opened on. Pagefind also
          takes a result title from the first h1 and was falling back to <title>, so a
          claim came back in search as "… — MathemAct" where a report came back clean. */}
      <blockquote class="claim__statement">
        <h1>{claim.statement}</h1>
      </blockquote>

      {/* Who proposed it, and nothing else. The second line here used to read "Active since
          <date>", which said something about a lifecycle the site no longer has: a claim has
          been part of the record from the moment it was written since post-moderation arrived
          on 2026-08-18, and `activated_at` is now a date on which nothing happened. Dating the
          claim also framed it as news rather than as a standing question, which is the
          opposite of what a claim is for. The date is still in the export and on the card in
          the listing, where "posted" is what it honestly means. */}
      <ul class="claim__meta" role="list">
        <li>
          {
            claim.author ? (
              <>
                Proposed by{' '}
                <a href={path(`/authors/${claim.author.id}/`)}>
                  {claim.author.displayName}
                </a>
                {claim.author.isPseudonym && ' (a pseudonym)'}
              </>
            ) : (
              <span class="card__erased">Proposer since erased</span>
            )
          }
        </li>
      </ul>
    </header>

    {
      claim.rationale && (
        <section
          class="field-block claim__rationale"
          data-quotable
          data-pagefind-body
        >
          <span class="field-block__label">Why this was proposed</span>
          <p class="field-block__body">{claim.rationale}</p>
        </section>
      )
    }

    {/* `data-contributions` and `data-position-changes` are export-time figures and are read
        off this element rather than fetched: neither is part of the distribution, so neither
        has to wait for the reader to answer, and neither needs the database. `statsFor` returns
        undefined for a claim the export has never seen — the empty string then keeps those two
        out of the statistics line entirely rather than printing a zero nobody counted. */}
    <section
      class="rate"
      data-rate
      data-claim-id={claim.id}
      data-contributions={statsFor(claim.id)?.contributionCount ?? ''}
      data-position-changes={statsFor(claim.id)?.positionChanges ?? ''}
      data-pagefind-ignore
    >
      {/* The asking block, and it is the whole of what somebody who has not answered sees of
          this section. Once they have answered it is removed outright — heading, scale and
          explanation — rather than collapsed or replaced by a summary of their own answer: the
          question has been asked and answered, and leaving a spent control on the page is how
          a reading page turns into a form. Their answer reappears as a marker on the chart,
          and one button under the chart reopens this block.

          The section numbers are gone with it. They were "1. Where do you stand?" and "2. How
          people answered", which only made sense while both were always present; a "2." with
          no "1." above it is a numbering that describes the page's history rather than the
          page. */}
      <section class="claim-panel claim-panel--vote" data-rate-ask hidden>
        <div class="claim-section-head">
          <h2>Where do you stand?</h2>

          <details class="claim-explainer">
            <summary>Why are results hidden until you answer?</summary>
            <p>
              We ask what you think before showing how everybody else
              responded, so their answers do not influence yours.
            </p>
          </details>
        </div>

        {/* Signed out. An anonymous reader cannot rate, so they cannot see the distribution
            either — the rule is about who has formed a view before looking, not about who is
            logged in, and making an exception here would be the loophole. */}
        <div class="panel" data-rate-signedout hidden>
          <p>
            <a href={path('/account/sign-in/')}>Sign in</a> to answer this one.
            The distribution appears once you have answered.
          </p>
        </div>

        <div class="panel" data-rate-unconfirmed hidden>
          <p>
            Answering needs a confirmed email address.
            <a href={path('/account/confirm/')}>
              Get another confirmation link
            </a>.
          </p>
        </div>

        {/* A position and its reason, in one form and one transaction. The reason half appears
            once a point on the scale is chosen — see AnswerContribution.astro and migration
            20261011110000, which refuses a scored first answer that arrives without one. */}
        <form class="form" data-rate-form hidden novalidate>
          <RatingScale name="score" />

          <AnswerContribution contributions={contributions} />

          <div class="actions rate__actions">
            <button class="button button--primary" type="submit">
              Record my position
            </button>
          </div>

          <FormStatus id="rate-status" />
        </form>
      </section>

      <section
        class="claim-panel claim-panel--results"
        data-rate-withheld
        hidden
      >
        <h2>How people answered</h2>

        <div class="results-placeholder">
          <strong>Results will appear here after you answer.</strong>
          <p>
            You'll see the complete distribution of scores from 0–10.
            We don't show results beforehand so your opinion isn't
            influenced by others.
          </p>
        </div>
      </section>

      <section
        class="claim-panel claim-panel--results"
        data-aggregate-wrap
        hidden
      >
        <h2>How people answered</h2>

        <Histogram />

        {/* One control, directly beneath the chart, and the only route back to the scale.
            It reopens the asking block rather than carrying its own copy of it — two scales on
            one page would be two sources of truth for the same answer. */}
        {/* Revealed only by the fixture branch in the script below, which a production build
            does not contain. It has to be visible, and it has to say the numbers are invented —
            a chart drawn from `data/` that looked like a chart drawn from the database would be
            a way to mislead myself, which is the only thing a fixture mode is really dangerous
            for. */}
        <p class="panel" data-fixtures hidden>
          <strong>Fixture distribution.</strong> These bars, and the answer marked as yours, come
          from <code>data/claim-ratings.json</code> rather than from the database — see
          <code>scripts/dev-seed.mjs</code>. Drop <code>?fixtures</code> from the address to go
          back to the real thing.
        </p>

        <p class="rate__again">
          <button class="button" type="button" data-rate-again>Update my answer</button>
        </p>

        {/* The form's own status element lives inside the asking block, which is hidden by the
            time a save has succeeded, so the confirmation needs somewhere still on screen. */}
        <FormStatus id="rate-outcome" />
      </section>
    </section>

    <References incoming={incoming} outgoing={outgoing} />

    <div data-pagefind-ignore>
      <Contributions
        parentId={claim.id}
        contributions={contributions}
        title={claim.statement}
        href={path(`/opinions/${claim.id}/`)}
      />
    </div>
  </div>
</Base>

<script>
  import { renderHistogram } from '../../lib/histogram';
  import { readCount } from '../../lib/claim-facets';
  import {
    answerClaim,
    fixtureAnswer,
    fixturesActive,
    loadAggregate,
    loadMyRating,
  } from '../../lib/claims';
  import { ANSWER_NEEDS_A_REASON, wireAnswerReason } from '../../lib/answer-form';
  import { loadMyEndorsements } from '../../lib/endorsements';
  import { loadProfile, mayPost } from '../../lib/profile';
  import { startSession, subscribeToSession } from '../../lib/session';
  import { hideStatus, query, setBusy, showStatus } from '../../lib/forms';

  const root = query<HTMLElement>('[data-rate]');
  const claimId = root.dataset.claimId!;

  /**
   * The two export-time figures, read off the page rather than fetched.
   *
   * Neither is part of the distribution — a count of contributions is a count of things
   * already visible further down, and "how many people changed position" says nothing about
   * where anybody stands — so neither has to wait for an answer and neither needs the
   * database. `NaN` when the attribute is empty, which is how a claim the export has never
   * counted keeps both out of the statistics line rather than printing a zero. `readCount` and
   * not `Number`, because `Number('')` is 0 — see the note on it.
   */
  const counts = {
    contributions: readCount(root.dataset.contributions),
    positionChanges: readCount(root.dataset.positionChanges),
  };

  const ask = query<HTMLElement>('[data-rate-ask]', root);
  const signedOut = query<HTMLElement>('[data-rate-signedout]', root);
  const unconfirmed = query<HTMLElement>('[data-rate-unconfirmed]', root);
  const form = query<HTMLFormElement>('[data-rate-form]', root);
  const withheld = query<HTMLElement>('[data-rate-withheld]', root);
  const wrap = query<HTMLElement>('[data-aggregate-wrap]', root);
  const histogram = query<HTMLElement>('[data-histogram]', root);
  const again = query<HTMLButtonElement>('[data-rate-again]', root);
  const status = query<HTMLElement>('#rate-status', root);
  const outcome = query<HTMLElement>('#rate-outcome', root);
  const submit = query<HTMLButtonElement>('button[type="submit"]', form);

  let userId: string | null = null;
  let iRated = false;
  let myScore: number | null = null;

  /** Set for one reveal only: the one immediately after a rating that *changed*. A first
   *  answer is not a position change, and neither is arriving on the page already having
   *  answered — so it is turned off again as soon as the reveal has read it. */
  let justChanged = false;

  /** Set for the same one reveal, when that save also posted text. The contributions section
   *  invites a new contribution after a change, and it would be inviting one just written. */
  let justPosted = false;

  const reason = wireAnswerReason(form);

  /**
   * Whether the reader has already given a reason on this claim, which makes the reason half
   * optional — the same question `private.assert_rating_has_contribution()` asks.
   *
   * Their own contributions are on the page, rendered by the build. Their endorsements are not,
   * and are read with the same own-rows-only query the contributions section uses. If that read
   * fails, the answer is "not that we know of": the form then asks for a reason it might not
   * need, which is the side to err on — the database decides either way.
   */
  async function readerState(
    id: string,
    rated: boolean,
    previousScore: number | null,
  ): Promise<void> {
    if (!reason) return;

    const items = [...document.querySelectorAll<HTMLElement>('[data-contribution]')];
    const wroteHere = items.some(
      (item) =>
        item.dataset.commentAuthor === id &&
        !item.querySelector(':scope > .contribution__removed'),
    );

    const mine = await loadMyEndorsements(
      items.map((item) => item.dataset.commentId ?? ''),
      id,
    );
    const endorsed = new Set(mine.ok ? mine.value.keys() : []);

    reason.setReader({
      userId: id,
      rated,
      previousScore,
      alreadyContributed: wroteHere || endorsed.size > 0,
      endorsed,
    });
  }

  if (fixturesActive()) {
    /**
     * Development only, and the same shape as the gate on /moderate/. `fixturesActive()`
     * compiles to `return false` in a production build, so this branch and everything it
     * reaches are removed before deploy — check the bundle rather than believing it.
     *
     * The session is skipped rather than faked. Nothing here can write: there is no token, so
     * every action the page offers still ends at row level security. What it buys is the
     * *reading* half — a chart whose bars agree with the contributions underneath them, and the
     * reader's own position group open, which is the sequence this page is built around and the
     * one thing an empty database cannot show.
     */
    const mine = fixtureAnswer(claimId);
    iRated = mine.rated;
    myScore = mine.score;
    reason?.setReader({
      userId: null,
      rated: mine.rated,
      previousScore: mine.score,
      alreadyContributed: false,
      endorsed: new Set(),
    });
    reflect();
    submit.textContent = 'Update my answer';
    void reveal().then(() => {
      query<HTMLElement>('[data-fixtures]', root).hidden = false;
    });
  } else {
    subscribeToSession((state) => {
      if (state.status === 'loading') return;

      if (state.status !== 'signed-in') {
        userId = null;
        // The scale is shown to an anonymous reader, disabled, with the sign-in prompt above
        // it. Hiding it entirely would leave the page with no sign of what it wanted from
        // them, and the distribution withheld for no visible reason.
        ask.hidden = false;
        signedOut.hidden = false;
        form.hidden = true;
        withheld.hidden = false;
        return;
      }

      if (userId === state.userId) return;
      userId = state.userId;
      void open(state.userId);
    });

    void startSession();
  }

  async function open(id: string): Promise<void> {
    const profile = await loadProfile(id);

    if (profile.ok && !mayPost(profile.value)) {
      ask.hidden = false;
      unconfirmed.hidden = false;
      withheld.hidden = false;
      return;
    }

    const mine = await loadMyRating(claimId, id);
    if (!mine.ok) {
      // The asking block goes up even so. A reader who cannot be told whether they have
      // answered is a reader who should be able to answer.
      ask.hidden = false;
      form.hidden = false;
      withheld.hidden = false;
      showStatus(status, 'error', mine.message);
      await readerState(id, false, null);
      return;
    }

    iRated = mine.value.rated;
    myScore = mine.value.score;
    await readerState(id, iRated, myScore);

    if (iRated) {
      reflect();
      submit.textContent = 'Update my answer';
      await reveal();
    } else {
      ask.hidden = false;
      form.hidden = false;
      withheld.hidden = false;
    }
  }

  /** Tick the answer they already gave, so reopening the scale starts from what they said
   *  rather than from nothing — which would read as never having answered. */
  function reflect(): void {
    const value = myScore === null ? 'none' : String(myScore);
    const input = form.querySelector<HTMLInputElement>(`input[name="score"][value="${value}"]`);
    if (!input) return;
    input.checked = true;
    // Setting `checked` fires nothing, and the reason half listens for `change` to decide what
    // to offer for the position now selected.
    input.dispatchEvent(new Event('change', { bubbles: true }));
  }

  async function reveal(): Promise<boolean> {
    const aggregate = await loadAggregate(claimId);
    if (!aggregate.ok) {
      // The chart needs the database and this is the one thing on the page that does. Say so
      // and leave the asking block up, rather than showing an empty chart or a row of zeros.
      ask.hidden = false;
      form.hidden = false;
      showStatus(status, 'error', aggregate.message);
      return false;
    }

    // Answered, so the question is spent: the whole asking block goes, and the button under
    // the chart is the way back to it.
    ask.hidden = true;
    withheld.hidden = true;
    wrap.hidden = false;
    renderHistogram(histogram, aggregate.value, myScore, iRated, counts);

    /**
     * Told, rather than fetched twice.
     *
     * The contributions section needs two things that only the distribution knows: which
     * position is the reader's own, so it can land there, and how many people answered at a
     * position nobody wrote from — which is the interesting empty state and is a fact about the
     * histogram. Neither may be in the page source before the reader has answered, and this is
     * the moment both become allowed.
     *
     * An event rather than a shared module holding DOM state: two components on one page, each
     * with its own script, and the only thing crossing between them is this payload.
     */
    document.dispatchEvent(
      new CustomEvent('mathemact:rated', {
        detail: {
          rated: iRated,
          score: myScore,
          // True only when this reveal follows a *change*, not a first answer or a
          // page load. A position change is an event; answering the first time is not.
          // Not when that change came with a new contribution: the invitation would be
          // asking for the thing just written.
          changed: justChanged && !justPosted,
          histogram: aggregate.value.histogram,
          noOpinionCount: aggregate.value.noOpinionCount,
        },
      }),
    );

    return true;
  }

  again.addEventListener('click', () => {
    hideStatus(status);
    hideStatus(outcome);
    ask.hidden = false;
    form.hidden = false;
    reflect();

    // Focus rather than scroll: it moves the keyboard to the control they asked for and the
    // browser brings it into view as a consequence, which is one behaviour instead of two.
    form.querySelector<HTMLInputElement>('input[name="score"]:checked')?.focus();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    hideStatus(status);

    if (!userId) return;

    const chosen = form.querySelector<HTMLInputElement>('input[name="score"]:checked')?.value;
    if (chosen === undefined) {
      showStatus(
        status,
        'error',
        'Choose a point on the scale, or say that you have no opinion — that is a real answer and it is recorded as one.',
      );
      return;
    }

    // 'none' is the "no opinion / outside my expertise" answer and is stored as a null
    // score on a real row. It is not the absence of a rating.
    const offScale = chosen === 'none';
    const score = offScale ? null : Number(chosen);
    const editing = iRated;

    // The reason, checked here for convenience and in the database for real. Same sentence in
    // both places, so a reader sees one rule however they arrive at it.
    const given = reason?.collect() ?? { body: '', endorsements: [] };
    if (reason?.required() && given.body === '' && given.endorsements.length === 0) {
      showStatus(status, 'error', ANSWER_NEEDS_A_REASON);
      reason.focus();
      return;
    }

    setBusy(submit, true, editing ? 'Updating…' : 'Recording…');
    const result = await answerClaim({
      claimId,
      score,
      offScale,
      body: given.body,
      endorsements: given.endorsements,
    });
    setBusy(submit, false);

    if (!result.ok) {
      showStatus(status, 'error', result.message);
      return;
    }

    iRated = true;
    myScore = score;
    submit.textContent = 'Update my answer';
    reason?.saved({ score, ...given });

    justChanged = editing;
    justPosted = given.body !== '';
    const revealed = await reveal();
    justChanged = false;
    justPosted = false;

    // The contribution, if one was written, goes into the section below straight away — after
    // the reveal, so it lands in the position group the reveal has just opened. The section
    // fetches it by id; `answer_claim()` returns no more than that.
    if (result.value) {
      document.dispatchEvent(
        new CustomEvent('mathemact:contributed', { detail: { id: result.value } }),
      );
    }

    const recorded = given.body
      ? // A contribution carries the position it was written from, publicly — so the line about
        // answers never appearing beside a name would be untrue of this one.
        'Recorded, with your contribution. It shows the position you wrote it from.'
      : editing
        ? 'Your position has been updated.'
        : 'Recorded. Your answer is never shown beside your name — only the distribution is.';

    /**
     * Where the confirmation goes depends on whether the chart came up, and getting that wrong
     * is what made a saved answer look like a failed one.
     *
     * `#rate-status` lives inside the asking block and `#rate-outcome` inside the results panel,
     * so at any moment exactly one of them is on screen. On success `reveal()` has hidden the
     * first and shown the second. **On failure it has done the opposite** — and the old code
     * wrote the confirmation into the hidden panel regardless, so all a reader saw was
     * `reveal()`'s error, which is about the distribution and said "nothing was saved" about an
     * answer that had just been saved.
     *
     * The answer is recorded either way: `answerClaim()` returned ok to get here. Only the
     * chart is missing, and the message now says which of the two happened.
     */
    if (revealed) {
      showStatus(outcome, 'success', recorded);
    } else {
      showStatus(status, 'notice', [
        recorded,
        'The distribution could not be loaded, so it is not shown below. Your answer is saved; reload the page to try again.',
      ]);
    }
  });
</script>
