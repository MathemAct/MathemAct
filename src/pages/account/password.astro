---
/**
 * Setting a new password.
 *
 * One page, two ways in: following the link from a reset email, which establishes a
 * session as it arrives, and being signed in already and wanting to change it. Both end at
 * the same call, so both use the same form.
 *
 * The gate is `none` rather than `required` even though a session is needed, because the
 * most important thing this page ever has to say is what a signed-out visitor sees — an
 * expired link. The layout's generic "this page is for signed-in members" would be true,
 * useless, and would hide the explanation underneath it.
 */
import Account from '../../layouts/Account.astro';
import Field from '../../components/Field.astro';
import FormStatus from '../../components/FormStatus.astro';
import { path } from '../../lib/paths';
import { LIMITS } from '../../lib/validation';
---

<Account
  title="Set a new password"
  description="Choose a new password for your account."
  gate="none"
>
  <FormStatus id="password-status" />

  <form class="form" id="password-form" hidden novalidate>
    <Field
      id="new-password"
      label="New password"
      type="password"
      required
      autocomplete="new-password"
      hint={`At least ${LIMITS.password.min} characters. A few unrelated words is easier to remember and harder to guess than a short password.`}
    />

    <div class="actions">
      <button class="button button--primary" type="submit">Set password</button>
    </div>
  </form>

  <div class="panel" data-needs-link hidden>
    <p>
      Setting a password needs either the link from a reset email or an already signed-in
      session. This browser has neither, which usually means the link has expired or has
      been used once already.
    </p>
    <p class="actions">
      <a class="button button--primary" href={path('/account/reset/')}>Send a new link</a>
      <a class="button" href={path('/account/sign-in/')}>Sign in</a>
    </p>
  </div>

  <div class="actions" data-done hidden>
    <a class="button button--primary" href={path('/account/')}>Go to your profile</a>
  </div>
</Account>

<script>
  import { readAuthErrorFromUrl, updatePassword } from '../../lib/auth';
  import { startSession, subscribeToSession } from '../../lib/session';
  import {
    clearFieldErrors,
    hideStatus,
    query,
    setBusy,
    showStatus,
    validateFields,
  } from '../../lib/forms';
  import { validatePassword } from '../../lib/validation';

  const status = query<HTMLElement>('#password-status');
  const form = query<HTMLFormElement>('#password-form');
  const needsLink = query<HTMLElement>('[data-needs-link]');
  const done = query<HTMLElement>('[data-done]');
  const submit = query<HTMLButtonElement>('button[type="submit"]', form);
  const password = query<HTMLInputElement>('#new-password', form);

  // First, before anything touches the address bar. A link that expired lands here with
  // the reason attached, and that reason is more useful than any state the session store
  // is about to report.
  const linkError = readAuthErrorFromUrl();
  if (linkError) showStatus(status, 'error', linkError);

  let settled = false;

  subscribeToSession((state) => {
    if (state.status === 'loading' || state.status === 'unavailable') return;

    // The form only appears once; a token refresh arriving mid-typing must not swap the
    // panel out from under someone.
    if (settled) return;
    settled = true;

    if (state.status === 'signed-in') {
      form.hidden = false;
      needsLink.hidden = true;
      return;
    }

    form.hidden = true;
    needsLink.hidden = false;
  });

  void startSession();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearFieldErrors(form);
    hideStatus(status);

    if (!validateFields([{ id: 'new-password', error: validatePassword(password.value) }], form)) {
      return;
    }

    setBusy(submit, true, 'Setting password…');
    const result = await updatePassword(password.value);
    setBusy(submit, false);

    if (!result.ok) {
      showStatus(status, 'error', result.message);
      return;
    }

    form.hidden = true;
    done.hidden = false;
    showStatus(status, 'success', [
      'Password set. You are signed in on this browser.',
      'Sessions on your other devices are unaffected — sign out there if you want them ended.',
    ]);
  });
</script>
