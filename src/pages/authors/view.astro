---
/**
 * Client-rendered author page for contributors who do not yet have a static one.
 *
 * `/authors/<id>/` is generated by getStaticPaths from the committed corpus, which means an
 * author page exists only for someone who already had a published report at the last
 * export. Somebody's *first* report therefore arrives with no author page behind it: the
 * report is live, its name is on it, and the link under that name is a 404 until the
 * nightly build runs. That window is exactly when a new contributor is most likely to click
 * it, having just posted and sent the link to a colleague.
 *
 * Pattern and rationale: same as /reports/view/, /opinions/view/ and /moderate/. Anon
 * fetches against PostgREST get what the static page bakes in — the profile, the published
 * reports, the staleness aggregate that decides each tombstone, their claims, and the
 * entries they have submitted. `/authors/<id>/` stays the canonical URL once a build has
 * run; nothing links here except pages that are themselves runtime-rendered.
 *
 * **Everything this page links to is a runtime-rendered view page**, because this page
 * exists precisely when the export cannot be trusted to contain the rows. A card title
 * pointing at /reports/<id>/ would reintroduce the 404 this page is here to remove — one
 * level down, and for the same reason.
 *
 * What is omitted relative to the static page: Pagefind indexing, and the tool-use date
 * under each tombstone. Both come back at the next build. The tombstone itself is not
 * omitted — an author page is where a reader judges a body of work, and rendering every
 * square as unverified would misreport it.
 */
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import Tombstone from '../../components/Tombstone.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { path } from '../../lib/paths';
---

<Base title="Contributor" description="Reports contributed to MathemAct.">
  <div class="shell corpus">
    <p class="breadcrumb"><a href={path('/reports/')}>← All reports</a></p>

    <div data-loading>
      <p class="field__hint">Loading…</p>
    </div>

    <div data-error hidden>
      <p>This contributor could not be found, or the account has since been erased.</p>
      <p><a href={path('/reports/')}>Back to all reports</a></p>
    </div>

    <div data-content hidden>
      <header class="corpus__header">
        <h1 data-name></h1>

        <p class="corpus__lead" data-pseudonym hidden>
          This is a pseudonym.
        </p>

        <div class="author__badges">
          <Badges pending />
        </div>

        <ul class="author__summary" role="list">
          <li>
            <span class="meta" data-count></span>
          </li>
          <li data-claim-count-item hidden>
            <span class="meta" data-claim-count></span>
          </li>
          <li data-entry-count-item hidden>
            <span class="meta" data-entry-count></span>
          </li>
        </ul>
      </header>

      <div class="empty" data-none hidden>
        <p class="empty__heading">Nothing published yet.</p>
        <p>
          This account exists and has posted nothing.
        </p>
      </div>

      <section data-reports hidden>
        <h2 class="author__section">Reports</h2>
        <div data-listing></div>
      </section>

      <section data-claims hidden>
        <h2 class="author__section">Claims proposed</h2>
        <ul class="claim-list" role="list" data-claim-list></ul>
        <p class="author__more"><a href={path('/opinions/')}>All opinions</a></p>
      </section>

      <section data-entries hidden>
        <h2 class="author__section">Network submitted</h2>
        <ul class="author__entries" role="list" data-entry-list></ul>
        <p class="author__more"><a href={path('/network/')}>All entries</a></p>
      </section>
    </div>

    {/* Cloned per report. The Tombstone is rendered here rather than assembled in script
        for the reason the listing does the same: its scoped styles belong to the file that
        authored the element, so a hand-built square would come out unstyled. Its two
        per-card values are mutated below. */}
    <template data-card>
      <article class="card">
        <div>
          <Tombstone status="unverified" />
        </div>

        <h3 class="card__title"><a data-title></a></h3>
        <p class="card__aim" data-aim></p>

        <ul class="card__facts" role="list">
          <li data-area></li>
          <li data-task></li>
        </ul>

        <ul class="card__tools" role="list" data-tools></ul>
      </article>
    </template>

    {/* One claim. Same classes as the opinions index, which are global. */}
    <template data-claim-card>
      <li class="claim-item">
        <a class="claim-item__link" data-statement></a>
        <p class="card__facts claim-item__facts">
          <span data-area></span>
          <span class="meta" data-when></span>
        </p>
      </li>
    </template>

    {/* One submitted entry. Same two lines as the static page: what it is, then where it
        goes and what kind of thing it is. */}
    <template data-entry-card>
      <li class="author__entry">
        <p class="author__entry-title">
          <a data-title rel="noopener noreferrer" target="_blank"></a>
          <span
            class="author__broken"
            title="This link was unreachable at the last monthly check"
            data-broken
            hidden>Link may be broken</span
          >
        </p>

        <ul class="card__facts" role="list">
          <li><span class="meta" data-url></span></li>
          <li data-category></li>
        </ul>
      </li>
    </template>
  </div>
</Base>

<style>
  .breadcrumb {
    margin-block-end: var(--space-md);
    font-size: var(--size-2);
  }

  .author__badges {
    margin-block-start: var(--space-md);
  }

  /* Kept identical to /authors/<id>/, which this page stands in for. One line per kind of
     contribution; see the note there for why they are not one line with rules between. */
  .author__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block: var(--space-md) 0;
    padding: 0;
    list-style: none;
    color: var(--ink-muted);
    font-size: var(--size-2);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    letter-spacing: var(--tracking-wide);
  }

  .author__section {
    margin-block: var(--space-xl) 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    font-weight: var(--weight-normal);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .author__entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author__entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-block: var(--space-sm);
    border-block-start: var(--border);
  }

  .author__entry-title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: baseline;
    margin: 0;
  }

  .author__broken {
    font-size: var(--size-1);
    font-style: italic;
    color: var(--ink-muted);
  }

  .author__more {
    margin-block-start: var(--space-md);
    font-size: var(--size-2);
  }
</style>

<script>
  import { longDate, verificationMonth } from '../../lib/format';
  import { areaLabel, taskTypeLabel } from '../../lib/report-schema';
  import { path } from '../../lib/paths';
  // categoryLabel only. Importing listNetwork here would pull data/network.json into
  // this page's bundle, and the whole point of this page is that it reads live.
  import { categoryLabel } from '../../lib/network';
  import type { NetworkCategory, NetworkLinkStatus } from '../../lib/network';
  import { OUTCOME, tombstoneFilled, tombstoneName } from '../../lib/status';
  import type { Outcome, TombstoneStatus } from '../../lib/status';

  const id = new URLSearchParams(window.location.search).get('id');

  const loadingEl = document.querySelector<HTMLElement>('[data-loading]')!;
  const errorEl = document.querySelector<HTMLElement>('[data-error]')!;
  const contentEl = document.querySelector<HTMLElement>('[data-content]')!;

  if (!id) {
    loadingEl.hidden = true;
    errorEl.hidden = false;
  } else {
    await init(id);
  }

  async function init(authorId: string): Promise<void> {
    const author = await fetchAuthor(authorId);

    if (!author) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      return;
    }

    document.title = `${author.displayName} | MathemAct`;
    setText('[data-name]', author.displayName);

    if (author.isPseudonym) {
      document.querySelector<HTMLElement>('[data-pseudonym]')!.hidden = false;
    }

    // Fill and reveal the badge block only when there is an institution to show.
    // What the badge claims is settled in Badges.astro; this only supplies the detail string.
    if (author.institution) {
      const { name, country, verifiedAt } = author.institution;
      setText(
        '[data-badge-detail]',
        `${name}, ${country} (${verificationMonth(verifiedAt)})`,
      );
      document.querySelector<HTMLElement>('[data-badge="institutional"]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-badges]')!.hidden = false;
    }

    // All three at once. A claim author and an entry submitter are contributors
    // whether or not they have ever posted a report, which is why /authors/<id>/ exists
    // for them too.
    const [reports, claims, entries] = await Promise.all([
      fetchReports(authorId),
      fetchClaims(authorId),
      fetchNetwork(authorId),
    ]);

    setText(
      '[data-count]',
      `${reports.length} published ${reports.length === 1 ? 'report' : 'reports'}`,
    );

    if (claims.length > 0) {
      setText(
        '[data-claim-count]',
        `${claims.length} ${claims.length === 1 ? 'claim' : 'claims'}`,
      );
      document.querySelector<HTMLElement>('[data-claim-count-item]')!.hidden = false;
      renderClaims(claims);
    }

    if (entries.length > 0) {
      setText(
        '[data-entry-count]',
        `${entries.length} ${entries.length === 1 ? 'entry' : 'entries'} submitted`,
      );
      document.querySelector<HTMLElement>('[data-entry-count-item]')!.hidden = false;
      renderNetwork(entries);
    }

    if (reports.length === 0) {
      if (claims.length === 0 && entries.length === 0) {
        document.querySelector<HTMLElement>('[data-none]')!.hidden = false;
      }
      loadingEl.hidden = true;
      contentEl.hidden = false;
      return;
    }

    // One request for every tombstone on the page, keyed by report. A report nobody has
    // confirmed has no row in the aggregate for the same reason it has an open square, so a
    // missing key means `unverified` rather than an error.
    const staleness = await fetchStaleness(reports.map((report) => report.id));

    const template = document.querySelector<HTMLTemplateElement>('[data-card]')!;
    const listing = document.querySelector<HTMLElement>('[data-listing]')!;
    for (const report of reports) {
      listing.append(card(template, report, staleness.get(report.id) ?? 'unverified'));
    }
    document.querySelector<HTMLElement>('[data-reports]')!.hidden = false;

    loadingEl.hidden = true;
    contentEl.hidden = false;
  }

  function renderClaims(claims: FetchedClaim[]): void {
    const template = document.querySelector<HTMLTemplateElement>('[data-claim-card]')!;
    const list = document.querySelector<HTMLElement>('[data-claim-list]')!;

    for (const claim of claims) {
      const node = (template.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;

      const statement = node.querySelector<HTMLAnchorElement>('[data-statement]')!;
      statement.textContent = claim.statement;
      // The view page again, for the reason the report links use it: a contributor reached
      // through this page may have posted the claim after the last build too.
      statement.href = path(`/opinions/view/?id=${claim.id}`);

      put(node, '[data-area]', areaLabel(claim.area));
      put(
        node,
        '[data-when]',
        claim.status === 'active'
          ? `Active since ${longDate(claim.activatedAt)}`
          : `Proposed ${longDate(claim.createdAt)}`,
      );

      list.append(node);
    }

    document.querySelector<HTMLElement>('[data-claims]')!.hidden = false;
  }

  function renderNetwork(entries: FetchedEntry[]): void {
    const template = document.querySelector<HTMLTemplateElement>('[data-entry-card]')!;
    const list = document.querySelector<HTMLElement>('[data-entry-list]')!;

    for (const entry of entries) {
      const node = (template.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;

      const title = node.querySelector<HTMLAnchorElement>('[data-title]')!;
      title.textContent = entry.title;
      title.href = entry.url;

      if (entry.linkStatus === 'unreachable') {
        node.querySelector<HTMLElement>('[data-broken]')!.hidden = false;
      }

      put(node, '[data-url]', entry.urlNormalised);
      put(node, '[data-category]', categoryLabel(entry.category));

      list.append(node);
    }

    document.querySelector<HTMLElement>('[data-entries]')!.hidden = false;
  }

  function card(
    template: HTMLTemplateElement,
    report: FetchedReport,
    status: TombstoneStatus,
  ): HTMLElement {
    const node = (template.content.cloneNode(true) as DocumentFragment)
      .firstElementChild as HTMLElement;

    const tombstone = node.querySelector<HTMLElement>('.tombstone')!;
    tombstone.dataset.outcome = report.outcome;
    tombstone.setAttribute('aria-label', tombstoneName(status, report.outcome));
    // `data-filled` is an attribute the CSS tests for presence, not for value, so it has to
    // be removed rather than set to something falsy.
    if (tombstoneFilled(status)) tombstone.dataset.filled = '';
    else delete tombstone.dataset.filled;
    const label = tombstone.querySelector<HTMLElement>('.tombstone__label');
    if (label) label.textContent = OUTCOME[report.outcome].label;

    const title = node.querySelector<HTMLAnchorElement>('[data-title]')!;
    title.textContent = report.title;
    title.href = path(`/reports/view/?id=${report.id}`);

    put(node, '[data-aim]', report.aim);
    put(node, '[data-area]', areaLabel(report.area));
    put(node, '[data-task]', taskTypeLabel(report.taskType));

    const tools = node.querySelector<HTMLElement>('[data-tools]')!;
    for (const tool of report.tools) tools.append(chip(tool.name, tool.version));
    for (const tag of report.tags) tools.append(chip(tag, null, true));

    return node;
  }

  function setText(selector: string, text: string): void {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) el.textContent = text;
  }

  function put(root: HTMLElement, selector: string, text: string): void {
    const element = root.querySelector<HTMLElement>(selector);
    if (element) element.textContent = text;
  }

  /** A tool or tag chip. Built rather than cloned: `.tool-chip` is global in corpus.css. */
  function chip(name: string, version: string | null, isTag = false): HTMLElement {
    const item = document.createElement('li');
    item.className = isTag ? 'tool-chip tool-chip--tag' : 'tool-chip';

    const label = document.createElement('span');
    label.className = 'tool-chip__name';
    label.textContent = name;
    item.append(label);

    if (version) {
      const number = document.createElement('span');
      number.className = 'tool-chip__version';
      number.textContent = version;
      item.append(number);
    }

    return item;
  }

  // ── Data fetch ────────────────────────────────────────────────────────────────────────

  interface FetchedAuthor {
    readonly displayName: string;
    readonly isPseudonym: boolean;
    readonly institution: {
      readonly name: string;
      readonly country: string;
      readonly verifiedAt: string;
    } | null;
  }

  interface FetchedClaim {
    readonly id: string;
    readonly statement: string;
    readonly area: string;
    readonly status: 'proposed' | 'active';
    readonly createdAt: string;
    readonly activatedAt: string | null;
  }

  interface FetchedEntry {
    readonly id: string;
    readonly title: string;
    readonly url: string;
    readonly urlNormalised: string;
    readonly category: NetworkCategory;
    readonly linkStatus: NetworkLinkStatus;
  }

  interface FetchedReport {
    readonly id: string;
    readonly title: string;
    readonly aim: string;
    readonly area: string;
    readonly taskType: string;
    readonly outcome: Outcome;
    readonly tools: readonly { name: string; version: string }[];
    readonly tags: readonly string[];
  }

  /** One GET, or none. Every failure is a null result: an id that is not a UUID, a paused
   *  project, a row RLS does not expose. All of them mean the same thing to a reader. */
  async function ask<T>(query: string): Promise<T[]> {
    const base = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
    if (!base || !key) return [];

    try {
      const response = await fetch(`${base}/rest/v1/${query}`, {
        headers: { apikey: key, Authorization: `Bearer ${key}` },
      });

      if (!response.ok) return [];
      const rows = await response.json();
      return Array.isArray(rows) ? rows : [];
    } catch {
      return [];
    }
  }

  async function fetchAuthor(id: string): Promise<FetchedAuthor | null> {
    // institution_source is deliberately absent: CLAUDE.md says it is never displayed, and
    // a column that is never displayed should not be in a query that feeds a page.
    const select =
      'display_name,is_pseudonym,institution_name,institution_country,institution_verified_at';

    const rows = await ask<RawProfile>(
      `profiles?select=${encodeURIComponent(select)}&id=eq.${encodeURIComponent(id)}&limit=1`,
    );

    const row = rows[0];
    if (!row) return null;

    return {
      displayName: row.display_name,
      isPseudonym: row.is_pseudonym,
      // All three or none. A name without a verification date would be the one claim the
      // badge exists not to make.
      institution:
        row.institution_name && row.institution_country && row.institution_verified_at
          ? {
              name: row.institution_name,
              country: row.institution_country,
              verifiedAt: row.institution_verified_at,
            }
          : null,
    };
  }

  /**
   * This author's published reports, newest first.
   *
   * The status and deleted_at filters restate what row level security already enforces for
   * the anonymous key, for the same reason src/lib/fresh.ts does: this is content rendered
   * as though it came from the corpus, and the day somebody widens a policy is the day it
   * would start showing pending submissions to everybody.
   */
  async function fetchReports(id: string): Promise<FetchedReport[]> {
    const select = [
      'id,title,aim,area,task_type,outcome',
      'report_tools(tool_name,tool_version)',
      'report_tags(tags(code))',
    ].join(',');

    const rows = await ask<RawReport>(
      `reports?select=${encodeURIComponent(select)}` +
        `&author_id=eq.${encodeURIComponent(id)}` +
        '&status=eq.published&deleted_at=is.null&order=created_at.desc',
    );

    return rows.map((row) => ({
      id: row.id,
      title: row.title,
      aim: row.aim,
      area: row.area,
      taskType: row.task_type,
      outcome: row.outcome,
      tools: (row.report_tools ?? []).map((tool) => ({
        name: tool.tool_name,
        version: tool.tool_version,
      })),
      tags: (row.report_tags ?? []).flatMap((link) => (link.tags ? [link.tags.code] : [])),
    }));
  }

  /**
   * This author's claims, newest first.
   *
   * `status=neq.hidden` rather than a positive filter, because both remaining values belong
   * here: a proposed claim is public and rateable, and being rated is how it is promoted. It
   * is the same clause the export uses.
   */
  async function fetchClaims(id: string): Promise<FetchedClaim[]> {
    const rows = await ask<RawClaim>(
      'claims?select=id,statement,area,status,created_at,activated_at' +
        `&author_id=eq.${encodeURIComponent(id)}` +
        '&status=neq.hidden&order=created_at.desc',
    );

    return rows.map((row) => ({
      id: row.id,
      statement: row.statement,
      area: row.area,
      status: row.status,
      createdAt: row.created_at,
      activatedAt: row.activated_at,
    }));
  }

  /** This author's published entries, newest first. Same restated filters, same reason. */
  async function fetchNetwork(id: string): Promise<FetchedEntry[]> {
    const rows = await ask<RawEntry>(
      'network_entries?select=id,title,url,url_normalised,category,link_status' +
        `&submitter_id=eq.${encodeURIComponent(id)}` +
        '&status=eq.published&deleted_at=is.null&order=created_at.desc',
    );

    return rows.map((row) => ({
      id: row.id,
      title: row.title,
      url: row.url,
      urlNormalised: row.url_normalised,
      category: row.category,
      linkStatus: row.link_status,
    }));
  }

  /** The tombstone status per report, straight from public.report_staleness. Never
   *  recomputed here: the same answer has to appear in a listing, on a page, and in the
   *  export. */
  async function fetchStaleness(ids: string[]): Promise<Map<string, TombstoneStatus>> {
    if (ids.length === 0) return new Map();

    const rows = await ask<RawStaleness>(
      'report_staleness?select=report_id,tombstone_status' +
        `&report_id=in.(${ids.map(encodeURIComponent).join(',')})`,
    );

    return new Map(rows.map((row) => [row.report_id, row.tombstone_status]));
  }

  interface RawProfile {
    display_name: string;
    is_pseudonym: boolean;
    institution_name: string | null;
    institution_country: string | null;
    institution_verified_at: string | null;
  }

  interface RawReport {
    id: string;
    title: string;
    aim: string;
    area: string;
    task_type: string;
    outcome: Outcome;
    report_tools: { tool_name: string; tool_version: string }[];
    report_tags: { tags: { code: string } | null }[];
  }

  interface RawStaleness {
    report_id: string;
    tombstone_status: TombstoneStatus;
  }

  interface RawClaim {
    id: string;
    statement: string;
    area: string;
    status: 'proposed' | 'active';
    created_at: string;
    activated_at: string | null;
  }

  interface RawEntry {
    id: string;
    title: string;
    url: string;
    url_normalised: string;
    category: NetworkCategory;
    link_status: NetworkLinkStatus;
  }
</script>
