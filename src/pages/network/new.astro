---
/**
 * Entry submission form.
 *
 * Short by design — title, URL, category, description — so that submitting a link takes
 * under a minute. The description is the field that makes the corpus worth having, and it
 * carries the whole of the prose: it used to be a 200-character "what is this" beside a
 * separate 600-character "why should mathematicians care", which asked one question twice.
 *
 * URL duplicate check: on blur of the URL field, the client normalises the URL and queries
 * Supabase for any existing entry with the same normalised form. If found, a non-blocking
 * warning links to the existing entry.
 */
import Account from '../../layouts/Account.astro';
import Field from '../../components/Field.astro';
import FormStatus from '../../components/FormStatus.astro';
import { path } from '../../lib/paths';
import { CATEGORIES } from '../../lib/network';
import { LICENCE, SITE } from '../../lib/site';

export const ENTRY_LIMITS = {
  title: 120,
  categoryOther: 80,
  description: 1000,
} as const;
---

<Account
  title="Submit an entry"
  description="Add a link to a tool, course, library, or guideline that is genuinely useful for mathematicians working with AI."
  lead="Four fields. Takes under a minute."
  gate="required"
>
  <div class="panel" data-gate-unconfirmed hidden>
    <p class="panel__heading">Confirm your email address first</p>
    <p>
      Submitting an entry needs a confirmed address.
    </p>
    <p class="actions">
      <a class="button button--primary" href={path('/account/confirm/')}>
        Get another confirmation link
      </a>
    </p>
  </div>

  <div class="panel" data-gate-banned hidden>
    <p class="panel__heading">This account cannot post</p>
    <p>
      If you think that is a mistake, write to{' '}
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
    </p>
  </div>

  <div data-form-wrapper hidden>
    {/* Non-blocking warning shown when the URL matches an existing entry. */}
    <div class="panel duplicate-warning" data-duplicate-warning hidden role="alert" aria-live="polite">
      <p>
        <strong>An entry with this URL already exists.</strong> Check whether it has already
        been submitted before adding a duplicate:
      </p>
      <p>
        <span class="duplicate-warning__title" data-duplicate-title></span>
        {' — '}
        <a class="duplicate-warning__link" data-duplicate-link href="" target="_blank" rel="noopener noreferrer"></a>
      </p>
      <p class="field__hint">You can still submit if the existing entry is substantially different from what you have in mind.</p>
    </div>

    <form class="entry-form" id="entry" novalidate>
      <FormStatus id="entry-status" />

      <Field
        id="title"
        label="Title"
        hint="A plain name for the entry. 120 characters."
        required
        maxlength={ENTRY_LIMITS.title}
        autocomplete="off"
        counter
      />

      <Field
        id="url"
        label="URL"
        type="url"
        hint="The link itself. Must start with https:// or http://."
        required
        autocomplete="off"
      />

      {/* A radio list, not a <select>, and the same shape as Area on the report form: a
          select hides most of the options and every one of their explanations. The visible
          label sits outside the fieldset because `.choices` is a grid of the choices alone
          — on the report the heading comes from the FormSection this short form has none
          of. See the choice-list block in forms.css. */}
      <div class="field">
        <p class="field__label">Category</p>
        <div class="field__hint" id="category-hint">
          <p>Choose the one that fits best.</p>
        </div>
        <fieldset class="choices" aria-describedby="category-hint">
          <legend class="visually-hidden">Category</legend>
          {
            CATEGORIES.map((c) => (
              <label class="choice" for={`category-${c.value}`}>
                <input
                  class="choice__input"
                  type="radio"
                  id={`category-${c.value}`}
                  name="category"
                  value={c.value}
                />
                <span>{c.label}</span>
                <span class="choice__hint">{c.hint}</span>
              </label>
            ))
          }
        </fieldset>
      </div>

      {/* Required exactly when the category is `other`, which is the only way "other" means
          anything — and the CHECK constraint refuses one on any other category. Hidden
          rather than disabled: a disabled control that never becomes enabled reads as
          broken. */}
      <div data-category-other hidden>
        <Field
          id="category_other"
          label="Say which"
          hint="A few words. It is what stops “other” from meaning nothing."
          maxlength={ENTRY_LIMITS.categoryOther}
        />
      </div>

      <Field
        id="description"
        label="Description"
        type="textarea"
        rows={5}
        hint={`Explain what it is and why it can be of interest to the community. In your own words — do not paste marketing copy. ${ENTRY_LIMITS.description} characters.`}
        required
        maxlength={ENTRY_LIMITS.description}
        counter
      />

      <div class="form-section">
        <label class="checkbox-label" for="cc-confirm">
          <input type="checkbox" id="cc-confirm" name="cc-confirm" required />
          I agree that this submission is published under{''}
          <a href={LICENCE.url} rel="license">{LICENCE.name}</a>
        </label>
      </div>

      <div class="actions">
        <button class="button button--primary" type="submit" data-submit>Submit entry</button>
        <a class="button" href={path('/network/')}>Cancel</a>
      </div>
    </form>
  </div>
</Account>

<script>
  import { getSupabase } from '../../lib/supabase';
  import { loadProfile, mayPost } from '../../lib/profile';
  import { startSession, subscribeToSession } from '../../lib/session';
  import { hideStatus, query, setBusy, showStatus, wireCounters } from '../../lib/forms';
  import { normaliseUrl } from '../../lib/network';
  import { path } from '../../lib/paths';

  const account  = query<HTMLElement>('[data-account]');
  const wrapper  = query<HTMLElement>('[data-form-wrapper]');
  const gateUnconfirmed = query<HTMLElement>('[data-gate-unconfirmed]');
  const gateBanned      = query<HTMLElement>('[data-gate-banned]');
  const form     = query<HTMLFormElement>('#entry');
  const status   = query<HTMLElement>('#entry-status');
  const submit   = query<HTMLButtonElement>('[data-submit]');

  const urlInput        = document.querySelector<HTMLInputElement>('#url');
  const duplicateWarning = document.querySelector<HTMLElement>('[data-duplicate-warning]');
  const duplicateTitle  = document.querySelector<HTMLElement>('[data-duplicate-title]');
  const duplicateLink   = document.querySelector<HTMLAnchorElement>('[data-duplicate-link]');

  // ── The "other" category ─────────────────────────────────────────────────────────────
  //
  // Same rule as area_other on the report form, and cleared for the same reason: the CHECK
  // constraint refuses a category_other on any category but `other`, so a value left behind
  // by somebody who picked "other", typed something, then changed their mind would fail the
  // submission from a field no longer on their screen.

  const categoryOtherField = document.querySelector<HTMLElement>('[data-category-other]');
  const categoryOtherInput = document.querySelector<HTMLInputElement>('#category_other');

  function syncCategoryOther(): void {
    if (!categoryOtherField) return;
    const chosen = form.querySelector<HTMLInputElement>('input[name="category"]:checked');
    const show = chosen?.value === 'other';
    categoryOtherField.hidden = !show;
    if (!show && categoryOtherInput) categoryOtherInput.value = '';
  }

  for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="category"]')) {
    radio.addEventListener('change', syncCategoryOther);
  }

  syncCategoryOther();

  let userId: string | null = null;

  wireCounters(form);

  subscribeToSession((state) => {
    if (state.status === 'loading') return;

    if (state.status !== 'signed-in') {
      account.dataset.gate = 'anonymous';
      return;
    }

    userId = state.userId;
    void open(state.userId);
  });

  void startSession();

  async function open(id: string): Promise<void> {
    const profile = await loadProfile(id);

    if (profile.ok && !mayPost(profile.value)) {
      if (!profile.value.confirmedAt) {
        gateUnconfirmed.hidden = false;
      } else {
        gateBanned.hidden = false;
      }
      return;
    }

    wrapper.hidden = false;
  }

  // ── URL duplicate check ──────────────────────────────────────────────────────────────

  if (urlInput && duplicateWarning && duplicateTitle && duplicateLink) {
    const urlEl       = urlInput;
    const warningEl   = duplicateWarning;
    const titleEl     = duplicateTitle;
    const linkEl      = duplicateLink;

    urlEl.addEventListener('blur', async () => {
      const raw = urlEl.value.trim();
      if (!raw) return;

      const normalised = normaliseUrl(raw);
      const supabase = getSupabase();
      if (!supabase) return;

      try {
        const { data } = await supabase
          .from('network_entries')
          .select('id,title,url')
          .eq('url_normalised', normalised)
          .eq('status', 'published')
          .is('deleted_at', null)
          .maybeSingle<{ id: string; title: string; url: string }>();

        if (data) {
          titleEl.textContent = data.title;
          linkEl.textContent  = data.url;
          linkEl.href         = data.url;
          warningEl.hidden    = false;
        } else {
          warningEl.hidden = true;
        }
      } catch {
        // Network failure: fail silently, do not block submission.
      }
    });

    urlEl.addEventListener('input', () => {
      warningEl.hidden = true;
    });
  }

  // ── Submission ───────────────────────────────────────────────────────────────────────

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!userId) return;

    hideStatus(status);

    const data = new FormData(form);
    const text = (name: string): string => ((data.get(name) as string | null) ?? '').trim();

    const title         = text('title');
    const url           = text('url');
    // Null when no radio is checked, which is the state the form loads in.
    const category      = (data.get('category') as string | null) ?? '';
    const categoryOther = text('category_other');
    const description   = text('description');
    const ccConfirm     = data.get('cc-confirm') === 'on';

    if (!title || !url || !description) {
      showStatus(status, 'error', 'Please fill in all fields.');
      return;
    }

    if (!category) {
      showStatus(status, 'error', 'Choose a category.');
      return;
    }

    if (category === 'other' && !categoryOther) {
      showStatus(status, 'error', 'Say which category, in a few words.');
      return;
    }

    if (!ccConfirm) {
      showStatus(status, 'error', 'Please confirm the CC BY 4.0 licence before submitting.');
      return;
    }

    if (!/^https?:\/\/.+/.test(url)) {
      showStatus(status, 'error', 'The URL must start with https:// or http://.');
      return;
    }

    const supabase = getSupabase();
    if (!supabase) {
      showStatus(status, 'error', 'The database is not reachable right now. Try again in a few minutes.');
      return;
    }

    setBusy(submit, true, 'Submitting…');

    const { error } = await supabase.from('network_entries').insert({
      submitter_id: userId,
      title,
      url,
      category,
      ...(category === 'other' ? { category_other: categoryOther } : {}),
      description,
    });

    setBusy(submit, false);

    if (error) {
      if (error.code === '23505') {
        showStatus(
          status,
          'error',
          'An entry with this URL has already been submitted. Check the entries listing.',
        );
      } else if (error.code === '53400') {
        showStatus(status, 'error', error.message);
      } else {
        showStatus(status, 'error', 'That did not go through. Check the URL and try again.');
      }
      return;
    }

    // Redirect to the listing on success. The entry is live already; the freshness overlay
    // is what puts it on the page before the next build.
    window.location.href = path('/network/?submitted=1');
  });
</script>

<style>
  .entry-form {
    max-width: var(--width-prose);
  }

  .form-section {
    margin-block: var(--space-lg);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    font-size: var(--size-3);
    cursor: pointer;
  }

  .duplicate-warning {
    margin-block-end: var(--space-lg);
  }

  .duplicate-warning__title {
    font-weight: var(--weight-semibold);
  }
</style>
