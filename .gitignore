# Dependencies and build output
node_modules/
dist/
.astro/

# Environment. The three PUBLIC_* values are public by design and may be committed, but
# .env is where a real secret would land by accident, so the whole file stays out.
# Committed template: .env.example
.env
.env.*
!.env.example

# Supabase CLI local state: linked-project bookkeeping and the Docker stack's scratch
# files. Machine-local, regenerated by `supabase link` / `supabase start`.
supabase/.temp/
supabase/.branches/
.branches/

# Editor and OS noise
.DS_Store
Thumbs.db
*.log

# Local working notes, not part of the project
CLAUDE.md
prompts/*.md

# ROR data dumps. ~290 MB, refreshed on ROR's schedule rather than ours, and a stale copy
# in the repository would be worse than none. See docs/ror.md.
*ror-data*.json
*ror-data*.csv
*ror-data*.zip
